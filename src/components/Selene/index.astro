<div class="chat-container">
  <iframe
    src="https://selene.sahilrana.in/"
    title="Selene | Sahil Rana portfolio assistant"
    width="100%"
    id="seleneChatIframe"
    style="border: none; border-radius: 12px; overflow: hidden; display: block; height: 62px;"
    allow="clipboard-read; clipboard-write;"
    sandbox="allow-scripts allow-same-origin allow-forms"
    loading="lazy"
  >
  </iframe>
</div>

<style>
  .chat-container {
    width: 100%;
    margin: 16px 0;
  }

  @media (min-width: 640px) {
    .chat-container {
      margin: 30px 0;
    }
  }

  .chat-container.selene-embed-active {
    isolation: isolate;
    box-shadow: 0 0 0 1px rgba(217, 201, 167, 0.08);
  }

  #seleneChatIframe {
    transition: height 280ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: height;
  }

  #seleneChatIframe.selene-resize-instant {
    transition: none;
  }
</style>

<script type="module">
  import { createEmbedLayoutController } from "./embedLayoutController.js";

  const iframe = document.getElementById("seleneChatIframe");
  const container = document.querySelector(".chat-container");
  const controller = createEmbedLayoutController(iframe, container);

  iframe?.addEventListener("load", () => {
    controller.applyLayout();
  });

  window.addEventListener("pagehide", () => {
    controller.detach();
  });

  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    controller.attach();
    controller.applyLayout();
  });

  controller.attach();
  controller.applyLayout();
</script>
