<div class="chat-container" style="width: 100%; margin: 30px 0;">
  <iframe
    src="https://selene.sahilrana.in/"
    title="Selene | Sahil Rana portfolio assistant"
    width="100%"
    id="seleneChatIframe"
    style="border: 1px solid hsla(0,0%,100%,.1); border-radius: 12px; overflow: hidden; display: block; height: 86px;"
    allow="clipboard-read; clipboard-write;"
    sandbox="allow-scripts allow-same-origin allow-forms"
    loading="lazy"
  >
  </iframe>
</div>

<style>
  #seleneChatIframe {
    transition: height 280ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: height;
  }
</style>

<script type="module">
  const IFRAME_HEIGHT = {
    collapsed: 86,
    defaultExpanded: 450,
    max: 600,
    min: 86,
  };

  const iframe = document.getElementById("seleneChatIframe");
  const allowedOrigin = iframe ? new URL(iframe.src).origin : "";

  const resizeIframe = (event) => {
    if (!allowedOrigin || event.origin !== allowedOrigin) return;
    if (event.source !== iframe?.contentWindow) return;
    if (event.data?.type !== "seleneHeight") return;

    const target = document.getElementById("seleneChatIframe");
    const receivedIsExpanded = Boolean(event.data.isExpanded);
    const rawHeight = Number(event.data.height);

    const fallbackHeight = receivedIsExpanded
      ? IFRAME_HEIGHT.defaultExpanded
      : IFRAME_HEIGHT.collapsed;

    const height =
      Number.isFinite(rawHeight) && rawHeight > 0 ? rawHeight : fallbackHeight;
    const clampedHeight = Math.min(
      Math.max(height, IFRAME_HEIGHT.min),
      IFRAME_HEIGHT.max,
    );

    if (target) {
      target.style.height = `${clampedHeight}px`;
    }
  };

  const attach = () => {
    window.removeEventListener("message", resizeIframe, false);
    window.addEventListener("message", resizeIframe, false);
  };

  const detach = () => {
    window.removeEventListener("message", resizeIframe, false);
  };

  window.addEventListener("pagehide", detach);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) attach();
  });

  attach();
</script>
