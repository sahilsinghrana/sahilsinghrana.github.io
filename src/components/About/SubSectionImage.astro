---
import ThreeDmoonLoader from "@components/General/Moon/ThreeDmoonLoader..astro";

const {
  className = "",
  src,
  alt,
  height,
  width,
  loading = "lazy",
} = Astro.props;
---

<div id="profilePicContainer" class="profilePicContainer">
  <div
    style="position: absolute; z-index: -1;top:-52%; opacity: 0.99;height: 300px; width: 95dvw; pointer-events:all; background:transparent;"
    id="moonRoot"
  >
  </div>
  <img
    class={className}
    src={src}
    alt={alt}
    height={height}
    width={width}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    decoding="async"
  />

  <ThreeDmoonLoader />
</div>

<script src="../General/Moon/3dMoon/main.js"></script>
