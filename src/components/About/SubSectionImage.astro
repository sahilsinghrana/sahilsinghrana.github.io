---
import ThreeDmoonLoader from "@components/General/Moon/ThreeDmoonLoader..astro";

const {
  className = "",
  src,
  alt,
  height,
  width,
  loading = "lazy",
} = Astro.props;
---

<div id="profilePicContainer" class="profilePicContainer">
  <div id="moonRoot">
  </div>
  <img
    class={className}
    src={src}
    alt={alt}
    height={height}
    width={width}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    decoding="async"
    crossorigin="anonymous"
  />

  <ThreeDmoonLoader />
</div>

<script src="../General/Moon/3dMoon/main.js"></script>
