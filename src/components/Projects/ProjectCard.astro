---
import RubiksCube from "@images/rubikscube.webp";
import ExternalLink from "lucide-astro/ExternalLink";

const {
  title,
  content,
  image,
  links,
  imageClassName = "",
  builtFor = "Personal",
  awards = [],
} = Astro.props;

import "./index.scss";
import { Image } from "astro:assets";

const displayImage = image || RubiksCube;
---

<div class="projectCard">
  <Image
    class={`projectCardImg ${imageClassName}`}
    src={displayImage}
    alt={title}
    width={410}
    height={150}
  />
  <div class="content">
    <h2>{title}</h2>
    <p class="builtFor">{builtFor}</p>
    <p>{content}</p>
  </div>

  {
    awards?.length > 0 && (
      <div class="awards">
        {awards.map((award) => (
          <div class="award">
            <p>{award?.title || ""}</p>
            {award?.links?.length > 0 && (
              <div class="awardSources">
                {award?.links.map(({ Icon: AwardIcon, url: awardUrl }) => (
                  <a href={awardUrl} target="_blank">
                    {AwardIcon ? <AwardIcon /> : <ExternalLink />}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    )
  }
  <ul class="links">
    {
      links.map(({ Icon, link }) => {
        if (!Icon) return null;
        return (
          <li>
            <a aria-label={link} href={link} target="_blank">
              <Icon />
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
