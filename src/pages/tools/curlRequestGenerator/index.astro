---
import { Schema } from "astro-seo-schema";
import ToolSectionHeaderImage from "@components/General/Image/ToolSectionHeaderImage.astro";
import Layout from "@layouts/index.astro";
import placeholderImage from "@images/tools/curlRequestGeneratorPlaceholder2.gif";

import { curlToolPageKeyWords } from "@utils/metaKeywords";
import moonFacts from "@utils/moonFacts";
import { SITE_ORIGIN } from "@utils/site";
import { links } from "@utils/constants";

import CurlRequestGenerator from "@components/Tools/CurlRequestGenerator/index.astro";

const toolUrl = `${SITE_ORIGIN}/tools/curlRequestGenerator`;
---

<Layout
  title="cURL Request Generator - Build API curl Commands Online | Sahil Rana"
  description="Free online cURL request generator. Build curl commands with headers, auth, JSON or multipart bodies, then copy or download bash-ready snippets."
  keywords={curlToolPageKeyWords}
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: "cURL Request Generator",
        url: toolUrl,
        description:
          "Build ready-to-run cURL commands for APIs with headers, authentication, JSON and multipart payloads, then copy or download snippets.",
        dateCreated: "2024-06-11T12:34:00+05:30",
        dateModified: "2025-09-29T12:00:00+05:30",
        mainEntity: {
          "@type": "SoftwareApplication",
          name: "cURL Request Generator",
          url: toolUrl,
          description:
            "Build ready-to-run cURL commands for APIs. Supports headers, auth, JSON and multipart file payloads, clipboard copy, and downloadable snippets.",
          applicationCategory: "DeveloperTool",
          operatingSystem: "All",
          softwareVersion: "1.2.0",
          isAccessibleForFree: true,
          featureList: [
            "Generate cURL commands",
            "Add headers and authentication",
            "JSON and multipart file payloads",
            "Copy to clipboard and download snippets",
            "Connection and advanced curl options",
          ],
          offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "USD",
            availability: "https://schema.org/InStock",
          },
          potentialAction: {
            "@type": "CreateAction",
            name: "Generate cURL command",
            target: {
              "@type": "EntryPoint",
              urlTemplate: toolUrl,
              actionPlatform: [
                "http://schema.org/DesktopWebPlatform",
                "http://schema.org/AndroidPlatform",
                "http://schema.org/IPhonePlatform",
              ],
            },
          },
          author: {
            "@type": "Person",
            name: "Sahil Rana",
            alternateName: ["Sahil Singh Rana", "sahilsinghrana"],
            identifier: "sahilsinghrana",
            jobTitle: "Sr. Software Developer",
            url: SITE_ORIGIN,
            sameAs: [links.linkedin, links.twitter, links.github],
          },
        },
        publisher: {
          "@type": "Person",
          name: "Sahil Rana",
          url: SITE_ORIGIN,
        },
        keywords: [
          "curl command generator",
          "generate curl command",
          "curl builder",
          "curl headers generator",
          "curl auth generator",
          "curl tool online",
        ],
      }}
    />
  </Fragment>
  <ToolSectionHeaderImage
    title="cURL Request Generator"
    Image={placeholderImage}
    quote={moonFacts.solarEclipse.fact}
  />

  <CurlRequestGenerator />

  <div class="moonFact">
    {moonFacts.lunarEclipse.fact}
  </div>
</Layout>
