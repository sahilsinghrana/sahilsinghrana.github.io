---
import { Schema } from "astro-seo-schema";
import SectionHeaderImage from "@components/General/Image/SectionHeaderImage.astro";
import Layout from "../layouts/index.astro";
import ProjectCard from "@components/Projects/ProjectCard.astro";
import projects from "@utils/projects";

import placeholderImage from "@images/placeholder3.webp";

import "@assets/styles/projects.scss";
import { projectsPageKeywords } from "@utils/metaKeywords";
import moonFacts from "@utils/moonFacts";
import { SITE_ORIGIN } from "@utils/site";
---

<Layout
  title="Projects | Sahil Rana"
  description="Projects by Sahil Rana - Atrij, DiZi Player, JSON tools, ESP8266 builds, and other web and experimental software."
  keywords={projectsPageKeywords}
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: "Projects by Sahil Rana",
        url: `${SITE_ORIGIN}/projects`,
        description:
          "A collection of software projects by Sahil Rana spanning web apps, developer tools, and experiments.",
        about: projects.map((project) => project.title),
      }}
    />
  </Fragment>
  <SectionHeaderImage
    title="Projects"
    Image={placeholderImage}
    quote={moonFacts.noMoonsOfMoon.fact}
  />

  <div class="projectList">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          content={project.content}
          links={project.links}
          image={project.image}
        />
      ))
    }
  </div>
  <div class="moonFact">
    {moonFacts.largerAtHorizon.fact}
  </div>
</Layout>
