---
import { Schema } from "astro-seo-schema";
import SectionHeaderImage from "@components/General/Image/SectionHeaderImage.astro";
import Layout from "../layouts/index.astro";
import placeholderImage from "@images/placeholder5comp.webp";

import BusinessCard from "@components/General/BusinessCard/index.astro";
import { links } from "@utils/constants";
import { Github, Instagram, Linkedin, Twitter } from "lucide-astro";

import "@assets/styles/contact.scss";
import { contactPageKeyWords } from "@utils/metaKeywords";
import moonFacts from "@utils/moonFacts";
import { SITE_ORIGIN } from "@utils/site";
---

<Layout
  title="Contact | Sahil Rana"
  description="Contact Sahil Rana - email, LinkedIn, GitHub, and X. Reach out about web development, collaborations, or questions."
  keywords={contactPageKeyWords}
>
  <Fragment slot="head">
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "ContactPage",
        name: "Contact Sahil Rana",
        url: `${SITE_ORIGIN}/contact`,
        description:
          "Contact Sahil Rana via email or social profiles for web development collaborations and questions.",
        mainEntity: {
          "@type": "Person",
          name: "Sahil Rana",
          email: "ranasahil98@gmail.com",
          url: SITE_ORIGIN,
          sameAs: [
            links.linkedin,
            links.twitter,
            links.github,
            links.instagram,
          ],
        },
      }}
    />
  </Fragment>
  <SectionHeaderImage
    title="Contact"
    Image={placeholderImage}
    quote={moonFacts.drifting.fact}
  />

  <div class="contactCardWrapper">
    <BusinessCard />
  </div>
  <div class="contactMe">
    <p class="mail">
      Feel free to get in touch with me via email at <a
        href="mailto:ranasahil98@gmail.com">ranasahil98@gmail.com</a
      >
    </p>

    <div>
      <p>Alternatively, you can connect with me on:</p>
      <ul>
        <small>
          <li>
            <Linkedin /> Linkedin : <a target="_blank" href={links.linkedin}
              >@sahilsinghrana</a
            >
          </li>
          <li>
            <Twitter /> X : <a target="_blank" href={links.twitter}
              >@sahilrana010</a
            >
          </li>
          <li>
            <Github /> Github : <a target="_blank" href={links.github}
              >@sahilsinghrana</a
            >
          </li>
          <li>
            <Instagram /> Instagram : <a target="_blank" href={links.instagram}
              >@sahilrana0_0</a
            >
          </li>
        </small>
      </ul>
    </div>
  </div>
  <div class="moonFact">
    {moonFacts.farSideTerrain.fact}
  </div>
</Layout>
