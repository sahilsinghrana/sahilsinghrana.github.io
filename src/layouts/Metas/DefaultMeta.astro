---
import { getCleanCanonicalUrl } from "@utils/getCanonicalUrl";

const { robots = "index, follow", canonicalPath } = Astro.props;
const currentUrl = getCleanCanonicalUrl(
  canonicalPath ?? Astro.url.pathname,
  Astro.site,
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />

<link rel="canonical" href={currentUrl} />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Sahil Rana Blog"
  href="/rss.xml"
/>
<meta
  name="google-site-verification"
  content="w4Q8_lhxctc5EB94weOcv_HFvNR7h_gyjZPRJcRuWqQ"
/>

<meta name="robots" content={robots} />
