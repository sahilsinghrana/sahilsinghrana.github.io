---
import { Head } from "astro-capo";
import { Font } from "astro:assets";

import Header from "@components/Header/index.astro";
import Footer from "@components/Footer/index.astro";
import Moon from "@components/General/Moon/index.astro";

import OgMeta from "./Metas/OgMeta.astro";
import DefaultMeta from "./Metas/DefaultMeta.astro";
import GtagHeadScripts from "./Metas/GtagHeadScripts.astro";
import DescriptionMeta from "./Metas/DescriptionMeta.astro";

const {
  title,
  description,
  keywords,
  className,
  robots = "index, follow",
  ogType = "website",
  ogImage,
  publishedTime,
  tags = [],
  canonicalPath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
} = Astro.props;

import "@styles/global.scss";
---

<html lang="en">
  <Head>
    <Font cssVariable="--font-raleway" preload />
    <Font cssVariable="--font-inter" />
    <DefaultMeta robots={robots} canonicalPath={canonicalPath} />
    <GtagHeadScripts />
    <OgMeta
      title={title}
      description={description}
      type={ogType}
      image={ogImage}
      publishedTime={publishedTime}
      tags={tags}
      canonicalPath={canonicalPath}
      imageWidth={ogImageWidth}
      imageHeight={ogImageHeight}
      imageAlt={ogImageAlt}
    />
    <DescriptionMeta
      title={title}
      description={description}
      keywords={keywords}
    />
    <slot name="head" />

    <title>{title}</title>
  </Head>

  <body>
    <Header />
    <Moon />
    <main>
      <div class={"content " + className}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import dateBasedClassInjector, {
    dateBasedJsAndCssInjector,
    dateBasedJsInjector,
  } from "src/scripts/dateBasedClassInjector";
  import { initStarAnimation } from "src/scripts/starAnimation";

  // dateBasedJsInjector(18, 6, "bdAlert");
  // dateBasedClassInjector(18, 6, "colorful");
  // dateBasedJsAndCssInjector(18, 6, "tulips");
  // dateBasedJsAndCssInjector(18, 6, "fireworks");

  dateBasedClassInjector(16, 1, "tulips");
  dateBasedJsInjector(16, 1, "tulips");

  dateBasedClassInjector(17, 1, "tulips");
  dateBasedJsInjector(17, 1, "tulips");

  dateBasedClassInjector(20, 1, "tulips");
  dateBasedJsInjector(20, 1, "tulips");

  dateBasedClassInjector(23, 1, "tulips");
  dateBasedJsInjector(23, 1, "tulips");

  dateBasedClassInjector(24, 1, "tulips");
  dateBasedJsInjector(24, 1, "tulips");

  dateBasedClassInjector(25, 1, "gray");

  dateBasedJsInjector(28, 11, "bdAlert");
  dateBasedClassInjector(28, 11, "colorful");
  dateBasedJsAndCssInjector(28, 11, "tulips");
  dateBasedJsAndCssInjector(28, 11, "fireworks");

  initStarAnimation();
</script>
